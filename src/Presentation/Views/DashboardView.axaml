<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AstroHabitsDesktop.Presentation.ViewModels"
             x:Class="AstroHabitsDesktop.Presentation.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <ScrollViewer Padding="32,28">
        <StackPanel Spacing="24">
            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="Mission Control Dashboard" FontSize="28" FontWeight="Bold"
                           Foreground="White"/>
                <TextBlock FontSize="14" Foreground="#5A6A7A">
                    <Run Text="Hora atual: "/>
                    <Run Text="{Binding HoraAtual}" Foreground="#F5A623"/>
                </TextBlock>
            </StackPanel>

            <!-- Cards Row 1 -->
            <UniformGrid Columns="3" Margin="0,4,0,0">
                <!-- Card: Fase Circadiana -->
                <Border Classes="card" Margin="0,0,12,0">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Fase Circadiana" FontSize="12" Foreground="#5A6A7A"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding FaseCircadiana}" FontSize="22" FontWeight="Bold"
                                   Foreground="#F5A623"/>
                        <TextBlock Text="{Binding FaseDescricao}" FontSize="12" Foreground="#8899AA"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Card: Modo de Órbita -->
                <Border Classes="card" Margin="6,0">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Modo de Órbita" FontSize="12" Foreground="#5A6A7A"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ModoOrbita}" FontSize="22" FontWeight="Bold"
                                   Foreground="White"/>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Delay:" FontSize="13" Foreground="#5A6A7A"/>
                            <TextBlock Text="{Binding DelayAtual}" FontSize="13" Foreground="#E8772E"
                                       FontWeight="Bold"/>
                            <TextBlock Text="min" FontSize="13" Foreground="#5A6A7A"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Card: Carga Cognitiva -->
                <Border Classes="card" Margin="12,0,0,0">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Carga Cognitiva" FontSize="12" Foreground="#5A6A7A"
                                   FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding UltimoScoreTlx}" FontSize="32" FontWeight="Bold"
                                       Foreground="#E8772E"/>
                            <TextBlock Text="/10" FontSize="16" Foreground="#5A6A7A"
                                       VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                        </StackPanel>
                        <TextBlock Text="{Binding ClassificacaoCarga}" FontSize="13" Foreground="#8899AA"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Cards Row 2 -->
            <UniformGrid Columns="2">
                <!-- Card: Tarefas -->
                <Border Classes="card" Margin="0,0,8,0">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Tarefas da Missão" FontSize="12" Foreground="#5A6A7A"
                                   FontWeight="SemiBold"/>
                        <UniformGrid Columns="3">
                            <StackPanel HorizontalAlignment="Center" Spacing="4">
                                <TextBlock Text="{Binding TotalTarefas}" FontSize="28" FontWeight="Bold"
                                           Foreground="White" HorizontalAlignment="Center"/>
                                <TextBlock Text="Total" FontSize="11" Foreground="#5A6A7A"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center" Spacing="4">
                                <TextBlock Text="{Binding TarefasPendentes}" FontSize="28" FontWeight="Bold"
                                           Foreground="#F5A623" HorizontalAlignment="Center"/>
                                <TextBlock Text="Pendentes" FontSize="11" Foreground="#5A6A7A"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center" Spacing="4">
                                <TextBlock Text="{Binding TarefasConcluidas}" FontSize="28" FontWeight="Bold"
                                           Foreground="#4CAF50" HorizontalAlignment="Center"/>
                                <TextBlock Text="Concluídas" FontSize="11" Foreground="#5A6A7A"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- Card: Tendência -->
                <Border Classes="card" Margin="8,0,0,0">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Análise de Tendência" FontSize="12" Foreground="#5A6A7A"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Tendencia}" FontSize="20" FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock Text="Baseado nos últimos registros Micro-TLX" FontSize="12"
                                   Foreground="#5A6A7A"/>
                    </StackPanel> 
                </Border>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
