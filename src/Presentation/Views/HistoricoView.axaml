<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AstroHabitsDesktop.Presentation.ViewModels"
             x:Class="AstroHabitsDesktop.Presentation.Views.HistoricoView"
             x:DataType="vm:HistoricoViewModel">

    <ScrollViewer Padding="32,28">
        <StackPanel Spacing="24">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="📈 Histórico de Registros" FontSize="28" FontWeight="Bold" Foreground="White"/>
                <Button Grid.Column="1" Classes="danger" Content="🗑️ Limpar Histórico"
                        Command="{Binding LimparHistoricoCommand}" VerticalAlignment="Center"/>
            </Grid>

            <!-- Stats Cards -->
            <UniformGrid Columns="3">
                <Border Classes="card" Margin="0,0,8,0">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <TextBlock Text="Total de Registros" FontSize="12" Foreground="#5A6A7A"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalRegistros}" FontSize="32" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Classes="card" Margin="4,0">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <TextBlock Text="Média Geral" FontSize="12" Foreground="#5A6A7A"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding MediaGeral}" FontSize="32" FontWeight="Bold"
                                   Foreground="#E8772E" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Classes="card" Margin="8,0,0,0">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <TextBlock Text="Tendência" FontSize="12" Foreground="#5A6A7A"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Tendencia}" FontSize="18" FontWeight="Bold"
                                   Foreground="#F5A623" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- TLX Records -->
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <TextBlock Text="Registros Micro-TLX" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                    <ListBox ItemsSource="{Binding Registros}" Background="Transparent" MaxHeight="300">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#0D1829" CornerRadius="10" Padding="16,12" Margin="0,2">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat={}{0:dd/MM HH:mm}}"
                                                   FontSize="12" Foreground="#5A6A7A" VerticalAlignment="Center"
                                                   Width="90"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                                            <TextBlock FontSize="12" Foreground="#8899AA">
                                                <Run Text="Mental: "/>
                                                <Run Text="{Binding DemandaMental, StringFormat={}{0:F0}}" Foreground="White"/>
                                            </TextBlock>
                                            <TextBlock FontSize="12" Foreground="#8899AA">
                                                <Run Text="Esforço: "/>
                                                <Run Text="{Binding Esforco, StringFormat={}{0:F0}}" Foreground="White"/>
                                            </TextBlock>
                                            <TextBlock FontSize="12" Foreground="#8899AA">
                                                <Run Text="Frustração: "/>
                                                <Run Text="{Binding Frustracao, StringFormat={}{0:F0}}" Foreground="White"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <Border Grid.Column="2" Background="#1A2744" CornerRadius="6"
                                                Padding="10,4" VerticalAlignment="Center" Margin="8,0">
                                            <TextBlock Text="{Binding Classificacao}" FontSize="12" Foreground="#F5A623"/>
                                        </Border>
                                        <TextBlock Grid.Column="3" Text="{Binding ScorePonderado, StringFormat={}{0:F1}}"
                                                   FontSize="16" FontWeight="Bold" Foreground="#E8772E"
                                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- Mission Logs -->
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <TextBlock Text="Logs da Missão" FontSize="16" FontWeight="SemiBold" Foreground="#F5A623"/>
                    <ListBox ItemsSource="{Binding Logs}" Background="Transparent" MaxHeight="200">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="12" Foreground="#5A6A7A"
                                           FontFamily="Cascadia Code,Consolas,monospace"
                                           Margin="0,2"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
