<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AstroHabitsDesktop.Presentation.ViewModels"
             x:Class="AstroHabitsDesktop.Presentation.Views.TarefasView"
             x:DataType="vm:TarefasViewModel">

    <ScrollViewer Padding="32,28">
        <StackPanel Spacing="24">
            <TextBlock Text="📋 Gerenciar Tarefas" FontSize="28" FontWeight="Bold" Foreground="White"/>

            <!-- Add Form -->
            <Border Classes="card">
                <StackPanel Spacing="16">
                    <TextBlock Text="Nova Tarefa" FontSize="16" FontWeight="SemiBold" Foreground="#F5A623"/>
                    <Grid ColumnDefinitions="*,*,Auto" RowDefinitions="Auto" Margin="0,4,0,0">
                        <TextBox Grid.Column="0" PlaceholderText="Título da tarefa..."
                                 Text="{Binding NovoTitulo}" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1" PlaceholderText="Descrição..."
                                 Text="{Binding NovaDescricao}" Margin="8,0"/>
                        <Button Grid.Column="2" Classes="accent" Content="+ Adicionar"
                                Command="{Binding AdicionarCommand}" Margin="8,0,0,0"/>
                    </Grid>
                    <TextBlock Text="{Binding Mensagem}" FontSize="13" Foreground="#F5A623"
                               IsVisible="{Binding Mensagem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>
            </Border>

            <!-- Task Actions -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="accent" Content="🚀 Iniciar" Command="{Binding IniciarCommand}"/>
                <Button Classes="secondary" Content="✅ Concluir" Command="{Binding ConcluirCommand}"/>
                <Button Classes="danger" Content="🗑️ Remover" Command="{Binding RemoverCommand}"/>
            </StackPanel>

            <!-- Tasks List -->
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <TextBlock Text="Tarefas Ativas" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                    <ListBox ItemsSource="{Binding Tarefas}"
                             SelectedItem="{Binding TarefaSelecionada}"
                             Background="Transparent"
                             MinHeight="200">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#0D1829" CornerRadius="10" Padding="16,12" Margin="0,2">
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <TextBlock Text="{Binding Titulo}" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="White"/>
                                            <TextBlock Text="{Binding Descricao}" FontSize="12" Foreground="#5A6A7A"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#1A2744" CornerRadius="6"
                                                Padding="10,4" VerticalAlignment="Center" Margin="8,0">
                                            <TextBlock Text="{Binding Status}" FontSize="12" Foreground="#F5A623"/>
                                        </Border>
                                        <Border Grid.Column="2" Background="#1A2744" CornerRadius="6"
                                                Padding="10,4" VerticalAlignment="Center">
                                            <TextBlock FontSize="12" Foreground="#8899AA">
                                                <Run Text="P"/>
                                                <Run Text="{Binding Prioridade}"/>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
