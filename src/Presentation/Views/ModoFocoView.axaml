<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AstroHabitsDesktop.Presentation.ViewModels"
             x:Class="AstroHabitsDesktop.Presentation.Views.ModoFocoView"
             x:DataType="vm:ModoFocoViewModel">

    <ScrollViewer Padding="32,28">
        <StackPanel Spacing="24">
            <TextBlock Text="🛰️ Modulação de Comunicação" FontSize="28" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="Selecione o modo de órbita para controlar o delay de notificações"
                       FontSize="14" Foreground="#5A6A7A"/>

            <!-- Orbit Mode Cards -->
            <UniformGrid Columns="3">
                <!-- Órbita Baixa -->
                <Border Classes="card" Margin="0,0,8,0" Cursor="Hand">
                    <Button Classes="secondary" HorizontalAlignment="Stretch" Command="{Binding SelecionarOrbitaBaixaCommand}"
                            Padding="0" Background="Transparent" BorderThickness="0">
                        <StackPanel Spacing="12" HorizontalAlignment="Center" Margin="8,12">
                            <TextBlock Text="🛰️" FontSize="40" HorizontalAlignment="Center"/>
                            <TextBlock Text="Órbita Baixa" FontSize="16" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center"/>
                            <TextBlock Text="0 min delay" FontSize="14" Foreground="#4CAF50"
                                       FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Comunicação instantânea"
                                       FontSize="12" Foreground="#5A6A7A" HorizontalAlignment="Center"
                                       TextAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>
                </Border>

                <!-- Lua -->
                <Border Classes="card" Margin="4,0">
                    <Button Classes="secondary" HorizontalAlignment="Stretch" Command="{Binding SelecionarLuaCommand}"
                            Padding="0" Background="Transparent" BorderThickness="0">
                        <StackPanel Spacing="12" HorizontalAlignment="Center" Margin="8,12">
                            <TextBlock Text="🌙" FontSize="40" HorizontalAlignment="Center"/>
                            <TextBlock Text="Lua" FontSize="16" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center"/>
                            <TextBlock Text="5 min delay" FontSize="14" Foreground="#F5A623"
                                       FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Foco intermediário"
                                       FontSize="12" Foreground="#5A6A7A" HorizontalAlignment="Center"
                                       TextAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>
                </Border>

                <!-- Marte -->
                <Border Classes="card" Margin="8,0,0,0">
                    <Button Classes="secondary" HorizontalAlignment="Stretch" Command="{Binding SelecionarMarteCommand}"
                            Padding="0" Background="Transparent" BorderThickness="0">
                        <StackPanel Spacing="12" HorizontalAlignment="Center" Margin="8,12">
                            <TextBlock Text="🔴" FontSize="40" HorizontalAlignment="Center"/>
                            <TextBlock Text="Marte" FontSize="16" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center"/>
                            <TextBlock Text="20 min delay" FontSize="14" Foreground="#E53935"
                                       FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Foco profundo"
                                       FontSize="12" Foreground="#5A6A7A" HorizontalAlignment="Center"
                                       TextAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>
                </Border>
            </UniformGrid>

            <!-- Current Status -->
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <TextBlock Text="Status Atual" FontSize="16" FontWeight="SemiBold" Foreground="#F5A623"/>
                    <StackPanel Orientation="Horizontal" Spacing="20">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Modo" FontSize="11" Foreground="#5A6A7A"/>
                            <TextBlock Text="{Binding ModoAtualNome}" FontSize="18" FontWeight="Bold" Foreground="White"/>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Delay" FontSize="11" Foreground="#5A6A7A"/>
                            <TextBlock FontSize="18" FontWeight="Bold" Foreground="#E8772E">
                                <Run Text="{Binding DelayAtual}"/>
                                <Run Text=" min"/>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Notificações Pendentes" FontSize="11" Foreground="#5A6A7A"/>
                            <TextBlock Text="{Binding NotificacoesPendentes}" FontSize="18" FontWeight="Bold" Foreground="#F5A623"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Notification Queue -->
            <Border Classes="card">
                <StackPanel Spacing="16">
                    <TextBlock Text="Fila de Notificações" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                        <TextBox Grid.Column="0" PlaceholderText="Simular notificação..."
                                 Text="{Binding NovaNotificacao}" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Classes="accent" Content="📩 Reter"
                                Command="{Binding AdicionarNotificacaoCommand}" Margin="0,0,4,0"/>
                        <Button Grid.Column="2" Classes="secondary" Content="📬 Despachar"
                                Command="{Binding DespacharFilaCommand}" Margin="4,0"/>
                        <Button Grid.Column="3" Classes="danger" Content="🗑️ Limpar"
                                Command="{Binding LimparFilaCommand}" Margin="4,0,0,0"/>
                    </Grid>

                    <TextBlock Text="{Binding Mensagem}" FontSize="13" Foreground="#F5A623"
                               IsVisible="{Binding Mensagem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                    <ListBox ItemsSource="{Binding NotificacoesDespachadas}"
                             Background="Transparent" MaxHeight="200">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#0D1829" CornerRadius="8" Padding="12,8" Margin="0,2">
                                    <TextBlock Text="{Binding}" FontSize="13" Foreground="#8899AA"/>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
